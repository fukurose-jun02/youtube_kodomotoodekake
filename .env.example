YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# scripts/sync-videos.js が使うOAuth認証情報（限定公開動画も取得するため）
# Google Cloud Console > APIs & Services > 認証情報 で
# 「OAuth クライアント ID」（アプリケーションの種類: デスクトップアプリ）を作成して設定する
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# 初回実行時にブラウザ認証を行うと自動で書き込まれるため、最初は空でよい
YOUTUBE_OAUTH_REFRESH_TOKEN=

# scripts/apply-categories.js が使う書き込み権限用トークン（クライアントID/シークレットは上と共用）
# 動画のタグを書き換えるため sync-videos.js とはスコープを分けている
# 初回実行時にブラウザ認証を行うと自動で書き込まれるため、最初は空でよい
YOUTUBE_OAUTH_WRITE_REFRESH_TOKEN=
