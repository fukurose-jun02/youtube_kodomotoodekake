{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kodomo-odekake",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // /api/* だけWorkerが先に処理し、それ以外は今までどおり静的ファイルを返す
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kodomo-odekake-chat",
      // 手順: npx wrangler d1 create kodomo-odekake-chat で作成し、表示されたIDに置き換える（マージ前に必須）
      "database_id": "REPLACE_WITH_REAL_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GEMINI_MODEL": "gemini-3.1-flash-lite",
    // チャットの1日の上限（1人あたり／サイト全体）。変えるときは、ここを直して再デプロイする
    "LIMIT_PER_IP": "15",
    "LIMIT_ALL": "50"
  }
}
